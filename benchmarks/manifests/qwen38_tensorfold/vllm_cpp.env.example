# Copy outside the repository, fill values measured from the build and weights,
# then pass the copy to tools/bench/run_qwen38_tensorfold_gap.sh.
ENGINE=vllm-cpp
SOURCE_DIR=
# Full git object ID of the exact clean vllm.cpp checkout being measured.
EXPECTED_REVISION=
# sha256sum format, one measured model/binary file per line. No guessed hashes.
ARTIFACT_MANIFEST=
ARTIFACT_ID=
ENDPOINT=http://127.0.0.1:8001/v1/completions
ENDPOINT_READY_URL=http://127.0.0.1:8001/health
MODEL=
TOKENIZER_IDENTITY=
LAUNCH_COMMAND=
MIN_FREE_MEMORY_KIB=
DRAFT=off
CONCURRENCY=1
WAVES=5
